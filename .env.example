OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=3002
# Portal API used by MCP tools. The agent never connects to MongoDB directly.
PORTAL_API_URL=http://localhost:3000
# Shared with the portal and used in both directions: the portal must send it on
# POST /api/assistant/chat, and the agent sends it on portal /api/mcp/* calls.
MCP_SERVICE_TOKEN=replace-with-the-same-long-random-secret-used-by-the-portal
# Whole-request budget; keep below the portal's ASSISTANT_AGENT_TIMEOUT_MS (25000).
AGENT_DEADLINE_MS=20000
PORTAL_TOOL_TIMEOUT_MS=8000
